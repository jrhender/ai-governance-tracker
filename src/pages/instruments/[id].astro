---
// src/pages/instruments/[id].astro
// Detail page for one policy instrument: the mitigations it advances, the
// technologies that enable it, and where it has been proposed.
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadPolicyGraph } from "../../content/loadPolicyGraph";
import { INSTRUMENT_TYPES } from "../../lib/mitigationTaxonomy";

export async function getStaticPaths() {
  const instruments = await getCollection("instruments");
  return instruments.map((instrument) => ({
    params: { id: instrument.id },
    props: { instrument },
  }));
}

const { instrument } = Astro.props;
const { data } = instrument;
const graph = await loadPolicyGraph();
const gi = graph.instruments.get(instrument.id)!;

const relationshipLabels: Record<string, string> = {
  implements: "implements",
  partially_implements: "partially implements",
  related: "related",
};

const chip = "rounded-full bg-body px-2 py-0.5 text-xs text-muted border border-border-lt";
const sectionHeading = "text-xs font-semibold uppercase tracking-wide text-faint mb-2";
---

<BaseLayout title={data.title} description={data.description?.trim()}>
  <p class="text-sm text-faint">
    <a href="/instruments/" class="text-accent-dark hover:underline">← Policy instruments</a>
  </p>
  <p class="mt-4 text-xs font-semibold uppercase tracking-wide text-faint">Policy instrument</p>
  <h1 class="mt-1 font-display text-3xl text-header">{data.title}</h1>
  <div class="mt-2 flex flex-wrap gap-1">
    <span class={chip}>{INSTRUMENT_TYPES[data.instrument_type]}</span>
  </div>

  {data.description && <p class="mt-6 text-ink">{data.description}</p>}

  <section class="mt-8">
    <h2 class={sectionHeading}>Advances these mitigations</h2>
    <ul class="space-y-1">
      {gi.advances.map((m) => (
        <li>
          <a href={`/mitigations/${m.id}/`} class="text-ink hover:text-accent-dark hover:underline">
            {m.title}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-8">
    <h2 class={sectionHeading}>Implementation in Canada</h2>
    {gi.implementations.length > 0 ? (
      <ul class="space-y-1 text-sm">
        {gi.implementations.map((impl) => (
          <li>
            <span class="text-faint">{relationshipLabels[impl.relationship]}: </span>
            <a
              href={`/${impl.kind === "artifact" ? "artifacts" : "events"}/${impl.id}/`}
              class="text-accent-dark hover:underline"
            >
              {impl.title}
            </a>
            {impl.note && <span class="text-faint"> — {impl.note}</span>}
          </li>
        ))}
      </ul>
    ) : (
      <p class="text-sm text-muted">No Canadian implementation tracked yet.</p>
    )}
  </section>

  <section class="mt-8" aria-labelledby="technologies-heading">
    <h2 id="technologies-heading" class={sectionHeading}>Enabling technologies</h2>
    {gi.technologies.length > 0 ? (
      <ul class="space-y-1">
        {gi.technologies.map((t) => (
          <li>
            <a href={`/technologies/${t.id}/`} class="text-ink hover:text-accent-dark hover:underline">
              {t.title}
            </a>
            {t.note && <span class="text-sm text-faint"> — {t.note}</span>}
          </li>
        ))}
      </ul>
    ) : (
      <p class="text-sm text-muted">No enabling technologies recorded; this instrument relies on institutional checks.</p>
    )}
  </section>

  {gi.proposedIn.length > 0 && (
    <section class="mt-8">
      <h2 class={sectionHeading}>Proposed in</h2>
      <ul class="space-y-1">
        {gi.proposedIn.map((a) => (
          <li>
            <a href={`/artifacts/${a.id}/`} class="text-ink hover:text-accent-dark hover:underline">
              {a.title}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {data.links.length > 0 && (
    <section class="mt-8">
      <h2 class={sectionHeading}>Sources</h2>
      <ul class="space-y-1">
        {data.links.map((l) => (
          <li>
            <a href={l.url} class="text-accent-dark hover:underline" target="_blank" rel="noopener noreferrer">
              {l.label} ↗
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
