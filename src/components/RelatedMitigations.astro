---
// src/components/RelatedMitigations.astro
// "Risks and mitigations" section for artifact and event pages.
import type { RelatedResult } from "../lib/relatedRiskMitigations";
import { MITIGATION_STATUSES } from "../lib/mitigationTaxonomy";

interface Props {
  related: RelatedResult;
  // Titles of artifacts that an event's links may come through.
  artifactTitles?: Record<string, string>;
}

const { related, artifactTitles = {} } = Astro.props;
const { mitigations, identifiedRisks } = related;

const statusColors: Record<string, string> = {
  untracked: "bg-gray-100 text-gray-600 border-gray-200",
  under_review: "bg-yellow-100 text-yellow-800 border-yellow-200",
  adopted: "bg-green-100 text-green-800 border-green-200",
  rejected: "bg-red-100 text-red-800 border-red-200",
};

const relationshipLabels: Record<string, string> = {
  implements: "Implements",
  partially_implements: "Partially implements",
  related: "Related to",
  recommends: "Recommends",
};

const riskChip =
  "rounded-full bg-body px-2 py-0.5 text-xs text-muted border border-border-lt hover:underline";
---

{(mitigations.length > 0 || identifiedRisks.length > 0) && (
  <section class="mt-8" aria-label="Risks and mitigations">
    <h2 class="text-xs font-semibold uppercase tracking-wide text-faint mb-2">
      Risks and mitigations
    </h2>
    {mitigations.length > 0 && (
      <ul class="space-y-2">
        {mitigations.map((m) => (
          <li class="rounded border border-border bg-surface p-3">
            <div class="flex items-start justify-between gap-3">
              <div>
                <span class="text-xs text-faint">{relationshipLabels[m.relationship]}</span>
                <div>
                  <a
                    href={`/mitigations/${m.id}/`}
                    class="text-sm font-medium text-ink hover:text-accent-dark hover:underline"
                  >
                    {m.title}
                  </a>
                </div>
              </div>
              <span
                class={`shrink-0 rounded-full px-2 py-0.5 text-xs border ${statusColors[m.status]}`}
              >
                {MITIGATION_STATUSES[m.status]}
              </span>
            </div>
            {m.note && <p class="mt-1 text-xs text-faint">{m.note}</p>}
            {m.viaArtifactId && (
              <p class="mt-1 text-xs text-faint">
                Through{" "}
                <a href={`/artifacts/${m.viaArtifactId}/`} class="text-accent-dark hover:underline">
                  {artifactTitles[m.viaArtifactId] ?? m.viaArtifactId}
                </a>
              </p>
            )}
            {m.risks.length > 0 && (
              <p class="mt-2 flex flex-wrap items-center gap-1 text-xs text-faint">
                Addresses:
                {m.risks.map((r) => (
                  <a href={`/map/#risk-${r.id}`} class={riskChip}>{r.title}</a>
                ))}
              </p>
            )}
          </li>
        ))}
      </ul>
    )}
    {identifiedRisks.length > 0 && (
      <p class="mt-3 flex flex-wrap items-center gap-1 text-sm text-faint">
        Risks identified:
        {identifiedRisks.map((r) => (
          <a href={`/map/#risk-${r.id}`} class={riskChip}>{r.title}</a>
        ))}
      </p>
    )}
    <p class="mt-3 text-xs text-faint">
      See the <a href="/map/" class="text-accent-dark hover:underline">full risk map</a>.
    </p>
  </section>
)}
