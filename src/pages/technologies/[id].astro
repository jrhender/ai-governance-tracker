---
// src/pages/technologies/[id].astro
// Detail page for one enabling technology: what it is, an example claim it
// could make checkable, and the policy instruments and mitigations it serves.
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadPolicyGraph } from "../../content/loadPolicyGraph";
import { TECHNOLOGY_DOMAINS } from "../../lib/mitigationTaxonomy";

export async function getStaticPaths() {
  const technologies = await getCollection("technologies");
  return technologies.map((technology) => ({
    params: { id: technology.id },
    props: { technology },
  }));
}

const { technology } = Astro.props;
const { data } = technology;
const graph = await loadPolicyGraph();
const gt = graph.technologies.get(technology.id)!;

const chip = "rounded-full bg-body px-2 py-0.5 text-xs text-muted border border-border-lt";
const sectionHeading = "text-xs font-semibold uppercase tracking-wide text-faint mb-2";
---

<BaseLayout title={data.title} description={data.summary.trim()}>
  <p class="text-sm text-faint">
    <a href="/mitigations/" class="text-accent-dark hover:underline">← Mitigations</a>
  </p>
  <p class="mt-4 text-xs font-semibold uppercase tracking-wide text-faint">Enabling technology</p>
  <h1 class="mt-1 font-display text-3xl text-header">{data.title}</h1>
  <div class="mt-2 flex flex-wrap gap-1">
    <span class={chip}>{TECHNOLOGY_DOMAINS[data.domain]}</span>
  </div>
  {data.also_known_as.length > 0 && (
    <p class="mt-2 text-sm text-faint">Also: {data.also_known_as.join(", ")}</p>
  )}

  <p class="mt-6 text-ink">{data.summary}</p>

  {data.example_claim && (
    <div class="mt-4 border-l-2 border-accent pl-3">
      <p class="text-ink">
        <span class="text-xs font-semibold uppercase tracking-wide text-faint">Example claim </span>
        “{data.example_claim}”
      </p>
      {data.why_it_matters && <p class="mt-1 text-sm text-muted">{data.why_it_matters}</p>}
    </div>
  )}

  <section class="mt-8" aria-labelledby="enables-heading">
    <h2 id="enables-heading" class={sectionHeading}>Enables these policy instruments</h2>
    {gt.instruments.length > 0 ? (
      <ul class="space-y-1">
        {gt.instruments.map((i) => (
          <li>
            <a href={`/instruments/${i.id}/`} class="text-ink hover:text-accent-dark hover:underline">
              {i.title}
            </a>
            {i.note && <span class="text-sm text-faint"> — {i.note}</span>}
          </li>
        ))}
      </ul>
    ) : (
      <p class="text-sm text-muted">Not yet linked to a policy instrument.</p>
    )}
  </section>

  {gt.mitigations.length > 0 && (
    <section class="mt-8">
      <h2 class={sectionHeading}>Which in turn advance</h2>
      <ul class="space-y-1">
        {gt.mitigations.map((m) => (
          <li>
            <a href={`/mitigations/${m.id}/`} class="text-ink hover:text-accent-dark hover:underline">
              {m.title}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {data.links.length > 0 && (
    <section class="mt-8">
      <h2 class={sectionHeading}>Sources</h2>
      <ul class="space-y-1">
        {data.links.map((l) => (
          <li>
            <a href={l.url} class="text-accent-dark hover:underline" target="_blank" rel="noopener noreferrer">
              {l.label} ↗
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
