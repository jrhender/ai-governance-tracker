---
// src/components/RelatedMitigations.astro
// "Risks and mitigations" section for artifact and event pages:
// policy → instrument → mitigation → risks, plus what a report recommends
// and the risks it identifies.
import type { RelatedResult } from "../lib/relatedRiskMitigations";
import MitigationLine from "./RelatedMitigationLine.astro";

interface Props {
  related: RelatedResult;
  // Titles of artifacts that an event's links may come through.
  artifactTitles?: Record<string, string>;
}

const { related, artifactTitles = {} } = Astro.props;
const { instruments, recommends, identifiedRisks } = related;

const relationshipLabels: Record<string, string> = {
  implements: "Implements",
  partially_implements: "Partially implements",
  related: "Related to",
};

const riskChip =
  "rounded-full bg-body px-2 py-0.5 text-xs text-muted border border-border-lt hover:underline";
const subHeading = "mt-4 mb-1 text-xs font-semibold text-faint";
---

{(instruments.length > 0 || recommends.length > 0 || identifiedRisks.length > 0) && (
  <section class="mt-8" aria-label="Risks and mitigations">
    <h2 class="text-xs font-semibold uppercase tracking-wide text-faint mb-2">
      Risks and mitigations
    </h2>

    {instruments.length > 0 && (
      <ul class="space-y-2">
        {instruments.map((inst) => (
          <li class="rounded border border-border bg-surface p-3">
            <span class="text-xs text-faint">
              {relationshipLabels[inst.relationship]} policy instrument
            </span>
            <div>
              <a
                href={`/instruments/${inst.id}/`}
                class="text-sm font-medium text-ink hover:text-accent-dark hover:underline"
              >
                {inst.title}
              </a>
            </div>
            {inst.note && <p class="mt-1 text-xs text-faint">{inst.note}</p>}
            {inst.viaArtifactId && (
              <p class="mt-1 text-xs text-faint">
                Through{" "}
                <a href={`/artifacts/${inst.viaArtifactId}/`} class="text-accent-dark hover:underline">
                  {artifactTitles[inst.viaArtifactId] ?? inst.viaArtifactId}
                </a>
              </p>
            )}
            {inst.mitigations.length > 0 && (
              <ul class="mt-2 space-y-1 border-l-2 border-border-lt pl-3">
                {inst.mitigations.map((m) => (
                  <MitigationLine m={m} />
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    )}

    {recommends.length > 0 && (
      <>
        <h3 class={subHeading}>Recommends</h3>
        <ul class="space-y-1 rounded border border-border bg-surface p-3">
          {recommends.map((m) => (
            <MitigationLine m={m} />
          ))}
        </ul>
      </>
    )}

    {identifiedRisks.length > 0 && (
      <p class="mt-3 flex flex-wrap items-center gap-1 text-sm text-faint">
        Risks identified:
        {identifiedRisks.map((r) => (
          <a href={`/map/#risk-${r.id}`} class={riskChip}>{r.title}</a>
        ))}
      </p>
    )}

    <p class="mt-3 text-xs text-faint">
      See the <a href="/map/" class="text-accent-dark hover:underline">full risk map</a>.
    </p>
  </section>
)}
